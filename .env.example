# --- qBittorrent -------------------------------------------------------------
QBIT_URL=http://seedbox:8080
# Soit une clé d'API (qBittorrent 5.2+)…
QBIT_API_KEY=
# …soit identifiant / mot de passe
QBIT_USERNAME=
QBIT_PASSWORD=
# Mettre à false si la WebUI utilise un certificat auto-signé
QBIT_VERIFY_TLS=true

# --- seedkit -----------------------------------------------------------------
SEEDKIT_DB=data/seedkit.db
# Fichier des règles de nettoyage (créé avec des exemples s'il n'existe pas)
SEEDKIT_CLEANUP_RULES=data/cleanup-rules.yaml
SEEDKIT_INTERVAL_MINUTES=10
SEEDKIT_HOST=0.0.0.0
SEEDKIT_PORT=8337
# Langue de l'interface : fr, en, ou vide pour suivre le navigateur (web) / la locale du système (CLI, TUI)
# SEEDKIT_LANG=
# URL du serveur pour la TUI (seedkit tui)
# SEEDKIT_URL=http://127.0.0.1:8337

# --- Verrous de sécurité (tout ce qui écrit dans qBittorrent est désactivé par défaut)
# Reannounce, recheck, tags
SEEDKIT_ALLOW_ACTIONS=false
# Suppression de torrents depuis l'écran Nettoyage
SEEDKIT_ALLOW_DELETE=false
# Tags automatiques du statut H&R (demande aussi SEEDKIT_ALLOW_ACTIONS=true)
SEEDKIT_AUTO_TAGS=false
SEEDKIT_TAG_PREFIX=sk:

# --- Rétention des snapshots : pleine résolution, puis 1/heure, puis 1/jour
SEEDKIT_RETENTION_FULL_DAYS=7
SEEDKIT_RETENTION_HOURLY_DAYS=90

# --- Notifications (désactivées si vide)
# SEEDKIT_NTFY_URL=https://ntfy.sh/mon-sujet-secret
# SEEDKIT_NTFY_TOKEN=
# SEEDKIT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/…
# Heure locale du résumé quotidien
SEEDKIT_SUMMARY_HOUR=9

# --- Accès SMB optionnel, en lecture seule (fichiers orphelins / manquants)
# SMB_SERVER=seedbox.local
# SMB_PORT=445
# SMB_USERNAME=
# SMB_PASSWORD=
# Chemin vu par qBittorrent = chemin SMB, plusieurs séparés par « ; »
# SEEDKIT_PATH_MAP=/downloads=//seedbox.local/downloads
